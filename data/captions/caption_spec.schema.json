{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MSHvSF Saturn caption spec (win-quote tables)",
  "description": "Input to tools/text/caption_compiler.py. Lines use A-Z, a-z, 0-9, space and ! . , ? ' \" - and the one-cell double exclamation (U+203C); each line is at most 19 cells (two characters per cell). '{P}' keeps the record's 0000 partner-name placeholder cell and is allowed only where the original record has it. Schema v2 (EXP-0028) lists several quote tables; all share one font. Schema v3 (mshvsf-captions/3, END-010) adds raw files (format 'raw'), several tables per file with any record index, placeholder 'anywhere', 'fields' (raw runs of cells, e.g. MM.BIN names) and 'patches' (raw bytes, e.g. name lengths); see tools/text/caption_compiler.py. v3 specs are generated by tools/text/official_endings.py and are not committed. An optional top-level 'glyph_style' selects how pair glyphs are drawn: 'quote' (default, squeezed full-width quote glyphs) or 'credits' (squeezed staff-credits glyphs, FONT-011, tools/text/credits_font.py).",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema",
        "records"
      ],
      "properties": {
        "schema": {
          "const": "mshvsf-captions/1"
        },
        "description": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "record",
              "lines"
            ],
            "additionalProperties": false,
            "properties": {
              "record": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "lines": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "pattern": "^([A-Za-z0-9 !.,?'\"\\-\u203c+:()]|\\{P\\}|\\{[0-9A-F]{4}\\})*$",
                  "maxLength": 41
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "schema",
        "tables"
      ],
      "properties": {
        "schema": {
          "const": "mshvsf-captions/2"
        },
        "description": {
          "type": "string"
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "file",
              "table",
              "records"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]+\\.(PAC|pac)$"
              },
              "table": {
                "type": "string",
                "pattern": "^0x[0-9A-Fa-f]+$"
              },
              "records": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": [
                    "record",
                    "lines"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "record": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 15
                    },
                    "lines": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "string",
                        "pattern": "^([A-Za-z0-9 !.,?'\"\\-\u203c+:()]|\\{P\\}|\\{[0-9A-F]{4}\\})*$",
                        "maxLength": 41
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
